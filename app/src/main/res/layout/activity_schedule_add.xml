<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ScheduleAdd"
    android:background="#00ff0000"
    android:orientation="vertical"
    android:weightSum="6">
    <TextView
        android:layout_marginTop="30dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:textSize="20dp"
        android:text="일정 추가"
        android:layout_weight="0.4"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:src="@drawable/calendaradd"
        android:layout_weight="0.5"/>

    <EditText
    android:id="@+id/scheduleTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginLeft="10dp"
    android:hint="일정 제목을 입력하시오."/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/addScheduleE"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_marginLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="4">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15dp"
                android:text="일정 시작"/>
            <TextView
                android:id="@+id/startDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/edge"
                android:layout_weight="1"
                android:textSize="20dp" />
            <TextView
                android:id="@+id/startDay_month"
                android:layout_width="0dp"
                android:layout_weight="0.6"
                android:background="@drawable/edge"
                android:layout_height="match_parent"
                android:textSize="20dp" />
            <TextView
                android:id="@+id/startDay_day"
                android:layout_width="0dp"
                android:layout_weight="0.6"
                android:background="@drawable/edge"
                android:layout_height="match_parent"
                android:textSize="20dp" />

            <ImageView
                android:id="@+id/startDate"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="0.5"
                android:scaleType="fitCenter"
                android:src="@drawable/date1" />

        </LinearLayout>
        <LinearLayout
            android:layout_marginLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:weightSum="4">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15dp"
                android:text="일정 종료"/>
            <TextView
                android:id="@+id/endDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/edge"
                android:layout_weight="1"
                android:textSize="20dp" />
            <TextView
                android:id="@+id/endDay_month"
                android:layout_width="0dp"
                android:layout_weight="0.6"
                android:background="@drawable/edge"
                android:layout_height="match_parent"
                android:textSize="20dp" />
            <TextView
                android:id="@+id/endDay_day"
                android:layout_width="0dp"
                android:layout_weight="0.6"
                android:background="@drawable/edge"
                android:layout_height="match_parent"
                android:textSize="20dp" />

            <ImageView
                android:id="@+id/endDate"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:scaleType="fitCenter"
                android:layout_weight="0.5"
                android:src="@drawable/date1"/>

        </LinearLayout>

   </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/border_layout"
        android:layout_weight="0.5">
        <EditText
            android:id="@+id/scheduleContents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="일정 내용을 입력하시오."
            android:layout_marginLeft="5dp"
            android:textSize="15dp"
            android:isScrollContainer="true"
            android:inputType="textMultiLine"
            android:maxHeight="100dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5">
        <Button
            android:layout_marginLeft="3dp"
            android:layout_marginRight="5dp"
            android:id="@+id/addBack"
            android:background="@drawable/btn_re"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_gravity="left"
            android:text="취소"/>

        <Button
            android:background="@drawable/btn_ba"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_marginRight="3dp"
            android:layout_gravity="end"
            android:id="@+id/scheduleAdd"
            android:text="추가" />

    </LinearLayout>


</LinearLayout>