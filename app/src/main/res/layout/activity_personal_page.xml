<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".personal_page"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:text="study For CE"
        android:textSize="15dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp">
        <TextView
            android:id="@+id/usertype"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="학생"
            android:textSize="35dp" />
        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="홍길동"
            android:textSize="60dp" />
    </LinearLayout>



    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_gravity="center">
        <ImageButton
            android:id="@+id/userinfo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginRight="5dp"
            android:layout_column="0"
            android:layout_row="0"
            android:src="@drawable/person"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:onClick="onButton_info"/>
        <ImageButton
            android:id="@+id/schedule"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginLeft="5dp"
            android:layout_column="1"
            android:layout_row="0"
            android:src="@drawable/schedule"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:onClick="onButton_schedule"/>
        <ImageButton
            android:id="@+id/userclasses"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="3dp"
            android:layout_row="1"
            android:layout_column="0"
            android:src="@drawable/classes"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:onClick="onButton_uclass"/>
        <ImageButton
            android:id="@+id/lock"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="3dp"
            android:layout_row="1"
            android:layout_column="1"
            android:src="@drawable/lock"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:onClick="onButton_lock"/>
    </GridLayout>

    <Button
        android:id="@+id/exit"
        android:layout_marginTop="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="나가기"
        android:onClick="app_exit"/>

</LinearLayout>