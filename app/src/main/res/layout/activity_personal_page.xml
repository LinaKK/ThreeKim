<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".personal_page"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/lay_back"
    android:weightSum="5">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/border"
    android:layout_margin="5dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="0.3"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:text="study For CE"
        android:textSize="15dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="0dp">
        <TextView
            android:id="@+id/usertype"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="학생"
            android:textSize="20dp" />
        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="홍길동"
            android:textSize="30dp" />
    </LinearLayout>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginTop="0dp"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_gravity="center">
        <ImageButton
            android:id="@+id/userinfo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginRight="5dp"
            android:layout_column="0"
            android:layout_row="0"
            android:src="@drawable/puser"
            android:padding="0sp"
            android:scaleType="centerCrop" />
        <ImageButton
            android:id="@+id/schedule"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginLeft="5dp"
            android:layout_column="1"
            android:layout_row="0"
            android:src="@drawable/pcalen"
            android:padding="0sp"
            android:scaleType="centerCrop" />
        <ImageButton
            android:id="@+id/userclasses"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="3dp"
            android:layout_row="1"
            android:layout_column="0"
            android:src="@drawable/pclass"
            android:padding="0sp"
            android:scaleType="centerCrop" />
        <ImageButton
            android:id="@+id/timer"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="3dp"
            android:layout_row="1"
            android:layout_column="1"
            android:src="@drawable/ptimer"
            android:padding="0sp"
            android:scaleType="centerCrop" />

    </GridLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_gravity="center">
<!--        <Button
            android:id="@+id/logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="로그아웃" />-->
        <Button
            android:id="@+id/exit"
            android:background="@drawable/btn_re"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="나가기" />
    </LinearLayout>


</LinearLayout>
</LinearLayout>