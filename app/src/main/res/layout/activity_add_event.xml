<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginRight="5dp"
    android:layout_marginLeft="5dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="20dp"
        android:text="이벤트 추가하기"
        android:layout_margin="15dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/selectEDate"
            android:src="@drawable/calendaradd"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp" />

        <EditText
            android:id="@+id/eDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
    </GridLayout>


    <EditText
        android:id="@+id/eData"
        android:background="@drawable/e_round"
        android:layout_marginTop="10dp"
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_weight="2.5"
        android:layout_height="0dp"
        android:gravity="center"
        android:hint="내용을 입력하세요."/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5">
        <Button
            android:layout_marginLeft="3dp"
            android:layout_marginRight="5dp"
            android:onClick="eventRe"
            android:background="@drawable/btn_re"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_gravity="left"
            android:text="취소"/>
        <Button
            android:id="@+id/updateE"
            android:background="@drawable/btn_ba"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="@dimen/botex"
            android:layout_gravity="end"
            android:text="확인"/>
    </LinearLayout>

</LinearLayout>