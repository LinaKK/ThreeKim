<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="15dp"
    tools:context=".Sign">

    <TextView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="35sp"
        android:padding="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        />


<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginBottom="30dp">
    <CheckBox
        android:id="@+id/chstu"
        android:textColor="#808080"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="학생"
        />
    <CheckBox
        android:id="@+id/chpro"
        android:textColor="#808080"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="교수"
        />
</LinearLayout>
    <EditText
        android:id="@+id/si_n"
        android:textcolor="#52a3cc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"
        android:ems="10"
        android:hint="이름"
        android:inputType="textPersonName" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="40dp"
        android:layout_marginBottom="10dp"
        android:padding="10dp">

        <EditText
            android:id="@+id/si_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ems="10"
            android:hint="학번/사번"
            android:inputType="textPersonName" />

        <Button
            android:id="@+id/btn1_idc"
            android:layout_width="85dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:background="@drawable/btnbl"
            android:text="중복체크"
            android:textColor="#52a3cc" />
    </LinearLayout>

    <EditText
        android:layout_gravity="center"
        android:id="@+id/si_pw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="비밀번호"
        android:inputType="textPassword"
        android:layout_marginBottom="20dp"

        />

    <EditText
        android:layout_gravity="center"
        android:id="@+id/si_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="EMAIL "
        android:inputType="textEmailAddress"
        android:layout_marginBottom="25dp"
        />


    <Button
        android:id="@+id/btn1_sign"
        android:layout_width="170dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:textColor="@color/white"
        android:background="@drawable/button_b"
        android:text="가입하기" />

   <!-- &lt;!&ndash; Link to Login Screen &ndash;&gt;
    <Button
        android:id="@+id/btnLoginScreen"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:text="btn_link_to_login"
        android:textAllCaps="false"
        android:textSize="15dp" />-->


    <TextView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Study for CE"

        android:textSize="15sp"
        android:padding="10dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="20dp"
        android:textColor="#7ea1e5"
        />
</LinearLayout>